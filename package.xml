<?xml version="1.0"?>
<package format="3">
  <name>rviz2_diagnostics_monitor</name>
  <version>0.1.0</version>
  <description>RViz 2 panel for monitoring ROS diagnostics with grouped device health, diagnostic history, severity filtering, and detailed status inspection.</description>
  <maintainer email="maik.knof@gmx.de">Maik Knof</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>rviz_common</depend>

  <build_depend>qtbase5-dev</build_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
